{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "features/**/*.ts",
    "pages/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}